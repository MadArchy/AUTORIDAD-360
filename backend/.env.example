# Canónico: MySQL 8.4 (ver PLAN_ESTABILIZACION.md / PLAN_FASES_AUTORIDAD360.md)
# Docker interno: @mysql:3306 | Host local: @localhost:3307
# NUNCA commitear .env real. Rotar secretos si se filtraron en un zip/entrega.

APP_ENV=development

DATABASE_URL=mysql+pymysql://autoridad:autoridadpass@localhost:3307/autoridad360
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e2b
CLIENT_NAME=Juan Vasquez
RSS_EXTRACT_CONCURRENCY=6
RSS_REQUEST_TIMEOUT_SECONDS=15
LLM_REQUEST_TIMEOUT_SECONDS=120
CONTENT_BATCH_GENERATION_ENABLED=true
CONTENT_CRITIC_ENABLED=false

# Motores de noticias opcionales (failover: Tavily → SerpAPI → Bing → Google News RSS → DDG).
# Sin claves, igual funciona con Google News RSS + DuckDuckGo.
# TAVILY_API_KEY=
# SERPAPI_API_KEY=
# BING_SEARCH_API_KEY=
# BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/news/search

CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002

# Secretos SEPARADOS (nunca reutilizar la misma clave; mínimo 32 caracteres).
# Operación: rotar JWT/API/SESSION si hubo zip/entrega con .env real; reiniciar API y forzar re-login.
JWT_SECRET_KEY=cambia-jwt-secret-en-produccion-min-32-chars
API_KEY_ENCRYPTION_KEY=cambia-encryption-key-en-produccion-min-32
SESSION_SECRET_KEY=cambia-session-secret-en-produccion-min-32
ENCRYPTION_KEY=cambia-encryption-key-en-produccion-min-32

# Auth: access JWT corto; refresh en cookie HttpOnly path=/api/v1/auth
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=14
COOKIE_SECURE=false
# true solo con tokens reales LinkedIn; default dry-run seguro
PUBLISH_NATIVE_LIVE=false

# Piloto local sin Docker API (excepción): VITE_API_URL=http://127.0.0.1:8012/api/v1
# Canónico: VITE_API_URL=http://127.0.0.1:8000/api/v1


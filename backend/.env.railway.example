# ============================================================
# Autoridad 360 — Variables de entorno para Railway (Producción)
# Copia este archivo como referencia y configura en el dashboard de Railway
# NUNCA subas este archivo con valores reales a git
# ============================================================

APP_ENV=production

# --- Base de datos (Railway MySQL Plugin) ---
# Railway genera este valor automáticamente al crear el plugin MySQL
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE

# --- Redis (Railway Redis Plugin) ---
# Railway genera este valor automáticamente al crear el plugin Redis
REDIS_URL=redis://default:PASSWORD@HOST:PORT

# --- Celery (usa la misma Redis) ---
CELERY_BROKER_URL=redis://default:PASSWORD@HOST:PORT/0
CELERY_RESULT_BACKEND=redis://default:PASSWORD@HOST:PORT/1

# --- IA / Ollama ---
# Opción A: Tu PC expuesta con Cloudflare Tunnel
# OLLAMA_BASE_URL=https://ollama.tu-tunel.trycloudflare.com
# Opción B: Groq (gratis con límite)
# OLLAMA_BASE_URL=  (vacío, se ignora)
OLLAMA_BASE_URL=https://TU-TUNNEL-OLLAMA.trycloudflare.com
OLLAMA_MODEL=gemma4:e2b

# --- CORS: URL de tu frontend en Vercel ---
CORS_ORIGINS=https://TU-PROYECTO.vercel.app,https://TU-DOMINIO-CUSTOM.com

# --- Secretos (genera con: openssl rand -hex 32) ---
JWT_SECRET_KEY=GENERA_CON_OPENSSL_RAND_HEX_32
API_KEY_ENCRYPTION_KEY=GENERA_CON_OPENSSL_RAND_HEX_32_DISTINTO
SESSION_SECRET_KEY=GENERA_CON_OPENSSL_RAND_HEX_32_DIFERENTE
ENCRYPTION_KEY=GENERA_CON_OPENSSL_RAND_HEX_32_OTRO

# --- Opcionales ---
CLIENT_NAME=Juan Vasquez
COOKIE_SECURE=true
PUBLISH_NATIVE_LIVE=false
